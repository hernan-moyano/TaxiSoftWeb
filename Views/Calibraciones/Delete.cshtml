@model TaxiSoftWeb.Models.CalibracionTaximetro

@{
    ViewData["Title"] = "Delete";
}

<h1>Eliminar</h1>

<h3>¿Está seguro que desea eliminar esta calibración?</h3>
<div>
    <h4>Calibración de Taxímetro</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Movil
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.IdVehiculoNavigation.Patente)
        </dd>
        <dt class="col-sm-2">
            Fecha de calibración
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.FechaCalibracion)
        </dd>
        <dt class="col-sm-2">
            Próxima calibración
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.ProximaCalibracion)
        </dd>
        <dt class="col-sm-2">
            Entidad calibradora
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.EntidadCalibradora)
        </dd>
        <dt class="col-sm-2">
            N° Certificado
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.NroCertificado)
        </dd>
        <dt class="col-sm-2">
            Valor
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Valor)
        </dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="IdCalibracion" />
        <input type="submit" value="Eliminar" class="btn btn-danger" /> |
        <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
    </form>
</div>