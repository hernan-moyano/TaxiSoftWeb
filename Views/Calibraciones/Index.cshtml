@model IEnumerable<TaxiSoftWeb.Models.CalibracionTaximetro>

@{
    ViewData["Title"] = "Index";
}
@if (TempData["Mensaje"] != null)
{
    <div class="row" style="margin-top:2%;">
        <div class="col-md-8">
            <div class="alert alert-danger alert-dismissible" role="alert">
                <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                @TempData["Mensaje"].ToString()
            </div>
        </div>
    </div>
}

<div class="card" style="padding: 1rem;">
    <div class="card-header">
        <h2>Calibraciones de Taxímetro</h2>
    </div>
    <div class="card-body table-responsive p-0">
        <table class="table" id="CalibracionesTable">
            <thead>
                <tr>
                    <th>Movil</th>
                    <th>Fecha de calibración</th>
                    <th>Próxima calibración</th>
                    <th>Entidad calibradora</th>
                    <th>N° Certificado</th>
                    <th>Valor</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@Html.DisplayFor(modelItem => item.IdVehiculoNavigation.Patente)</td>
                        <td>@item.FechaCalibracion?.ToString("dd/MM/yyyy")</td>
                        <td>
                            @if (item.ProximaCalibracion.HasValue && (item.ProximaCalibracion.Value.Date - DateTime.Today).Days <= 15)
                            {
                                <span class="badge badge-warning">@item.ProximaCalibracion?.ToString("dd/MM/yyyy")</span>
                            }
                            else
                            {
                                @item.ProximaCalibracion?.ToString("dd/MM/yyyy")
                            }
                        </td>
                        <td>@Html.DisplayFor(modelItem => item.EntidadCalibradora)</td>
                        <td>@Html.DisplayFor(modelItem => item.NroCertificado)</td>
                        <td>@Html.DisplayFor(modelItem => item.Valor)</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.IdCalibracion" class="btn btn-outline-warning"><i class="fas fa-edit"></i></a>
                            <a asp-action="Details" asp-route-id="@item.IdCalibracion" class="btn btn-outline-info"><i class="fas fa-info-circle"></i></a>
                            <a asp-action="Delete" asp-route-id="@item.IdCalibracion" class="btn btn-outline-danger"><i class="fas fa-trash"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <div class="card-body">
        <a asp-action="Create" class="btn btn-outline-success"><i class="fas fa-plus"></i> Agregar</a>
    </div>
</div>