@model TaxiSoftWeb.Models.GastoOperacion

@{
    ViewData["Title"] = "Details";
}

<h1>Detalles</h1>

<div>
    <h4>Gasto de Operación</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Fecha
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.FechaGasto)
        </dd>
        <dt class="col-sm-2">
            Movil
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.IdVehiculoNavigation.Patente)
        </dd>
        <dt class="col-sm-2">
            Chofer
        </dt>
        <dd class="col-sm-10">
            @(Model.CuilNavigation != null ? $"{Model.CuilNavigation.Apellido} {Model.CuilNavigation.Nombre}".Trim() : "")
        </dd>
        <dt class="col-sm-2">
            Tipo de gasto
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.IdTipoGastoNavigation.Nombre)
        </dd>
        <dt class="col-sm-2">
            Descripción
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Descripcion)
        </dd>
        <dt class="col-sm-2">
            Importe
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Importe)
        </dd>
        <dt class="col-sm-2">
            Kilometraje
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Kilometraje)
        </dd>
        <dt class="col-sm-2">
            N° Factura
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.NroFactura)
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.IdGasto" class="btn btn-warning">Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>