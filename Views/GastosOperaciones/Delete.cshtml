@model TaxiSoftWeb.Models.GastoOperacion

@{
    ViewData["Title"] = "Delete";
}

<h1>Eliminar</h1>

<h3>¿Está seguro que desea eliminar este gasto?</h3>
<div>
    <h4>Gasto de Operación</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            Fecha
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.FechaGasto)
        </dd>
        <dt class="col-sm-2">
            Movil
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.IdVehiculoNavigation.Patente)
        </dd>
        <dt class="col-sm-2">
            Chofer
        </dt>
        <dd class="col-sm-10">
            @(Model.CuilNavigation != null ? $"{Model.CuilNavigation.Apellido} {Model.CuilNavigation.Nombre}".Trim() : "")
        </dd>
        <dt class="col-sm-2">
            Tipo de gasto
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.IdTipoGastoNavigation.Nombre)
        </dd>
        <dt class="col-sm-2">
            Descripción
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Descripcion)
        </dd>
        <dt class="col-sm-2">
            Importe
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Importe)
        </dd>
        <dt class="col-sm-2">
            Kilometraje
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Kilometraje)
        </dd>
        <dt class="col-sm-2">
            N° Factura
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.NroFactura)
        </dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="IdGasto" />
        <input type="submit" value="Eliminar" class="btn btn-danger" /> |
        <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
    </form>
</div>