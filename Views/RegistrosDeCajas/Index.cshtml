@model IEnumerable<TaxiSoftWeb.Models.RegistrosDeCaja>
@{
    ViewData["Title"] = "Index";
}
@if (TempData["Mensaje"] != null)
{
    <div class="row" style="margin-top:2%;">
        <div class="col-md-8">
            <div class="alert alert-danger alert-dismissible" role="alert">
                <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                @TempData["Mensaje"].ToString()
            </div>
        </div>
    </div>
}



    <div class="card" style="padding: 1rem;">
        <div class="card-header">
            <h2>Cierres de Caja</h2>
        </div>
        <div class="card-body">
            <form asp-action="Index" method="get" class="row">
                <div class="form-group col-md-3">
                    <label>Desde</label>
                    <input type="date" name="desde" class="form-control" value="@ViewData["desde"]" />
                </div>
                <div class="form-group col-md-3">
                    <label>Hasta</label>
                    <input type="date" name="hasta" class="form-control" value="@ViewData["hasta"]" />
                </div>
                <div class="form-group col-md-3 align-self-end">
                    <input type="submit" value="Filtrar" class="btn btn-primary" />
                    <a asp-action="Index" class="btn btn-secondary">Limpiar</a>
                </div>
            </form>
        </div>
        <div class="card-body table-responsive p-0">
            <table class="table table-hover" id="CajaTable">
                <thead>
                    <tr>
                        <th>
                            Fecha
                        </th>
                        <th>
                            Turno
                        </th>

                        <th>
                            Movil
                        </th>

                        <th>
                            @Html.DisplayNameFor(model => model.Importe)
                        </th>

                        <th>
                            Caja/Chofer
                        </th>
                        <th>
                            Operaci�n
                        </th>
                    <th>
                        Acciones
                    </th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @Html.DisplayFor(modelItem => item.FechaRegisCaja)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.IdTurnoNavigation.NomTurno)
                        </td>

                        <td>
                            @Html.DisplayFor(modelItem => item.IdVehiculoNavigation.Patente)
                        </td>

                        <td>
                            @Html.DisplayFor(modelItem => item.Importe)
                        </td>

                        <td>
                            @Html.DisplayFor(modelItem => item.IdCajaNavigation.NomCaja)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.IdOperacionNavigation.NomOperacion)
                        </td>


                        <td>
                            <a asp-action="Edit" asp-route-id="@item.IdRegistroCaja" class="btn btn-outline-warning"><i class="fas fa-edit"></i></a>
                            <a asp-action="Details" asp-route-id="@item.IdRegistroCaja" class="btn btn-outline-info"><i class="fas fa-info-circle"></i></a>
                            <a asp-action="Delete" asp-route-id="@item.IdRegistroCaja" class="btn btn-outline-danger"><i class="fas fa-trash"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

    </div>
    <div class="card-body">
        <a asp-action="Create" class="btn btn-outline-success"><i class="fas fa-plus"></i> Agregar</a>
    </div>
</div>


    @section scripts{


}


