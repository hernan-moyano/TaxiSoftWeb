@model IEnumerable<TaxiSoftWeb.ViewModels.NotificacionItem>
@{
    var notificaciones = Model?.ToList() ?? new List<TaxiSoftWeb.ViewModels.NotificacionItem>();
    var total = notificaciones.Count;
    var visibles = notificaciones.Take(5).ToList();
}
<!-- Notifications Dropdown Menu -->
<li class="nav-item dropdown">
    <a class="nav-link" data-toggle="dropdown" href="#">
        <i class="far fa-bell"></i>
        @if (total > 0)
        {
            <span class="badge badge-warning navbar-badge">@total</span>
        }
    </a>
    <div class="dropdown-menu dropdown-menu-lg dropdown-menu-right">
        <span class="dropdown-header">@(total == 1 ? "1 notificación" : $"{total} notificaciones")</span>
        <div class="dropdown-divider"></div>
        @if (visibles.Count == 0)
        {
            <span class="dropdown-item text-center text-muted">No hay alertas activas</span>
            <div class="dropdown-divider"></div>
        }
        else
        {
            foreach (var notificacion in visibles)
            {
                var esManual = notificacion.Tipo == "manual";
                var action = esManual ? "Index" : "Vencimientos";
                <a asp-controller="Alertas" asp-action="@action" class="dropdown-item">
                    @if (esManual)
                    {
                        <i class="fas fa-exclamation-triangle mr-2 text-warning"></i>
                    }
                    else
                    {
                        <i class="fas fa-calendar-check mr-2 text-info"></i>
                    }
                    <span class="badge badge-light mr-1">@(esManual ? "Manual" : "Sistema")</span>
                    @notificacion.Descripcion
                    <span class="float-right text-muted text-sm">@notificacion.FechaVencimiento?.ToString("dd/MM/yyyy")</span>
                </a>
                <div class="dropdown-divider"></div>
            }
        }
        <a asp-controller="Alertas" asp-action="Vencimientos" class="dropdown-item dropdown-footer">Ver todos los vencimientos</a>
    </div>
</li>